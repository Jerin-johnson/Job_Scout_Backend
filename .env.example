# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
TRUST_PROXY=1

# Security & Cryptography
JWT_ACCESS_SECRET=jobscout_super_secret_access_key_at_least_32_chars_long_12345
JWT_REFRESH_SECRET=jobscout_super_secret_refresh_key_at_least_32_chars_long_12345
RESUME_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Databases
MONGODB_URI=mongodb://localhost:27017/jobscout
REDIS_URL=redis://localhost:6379

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
LOG_LEVEL=info

# AI Models & Gateways
ANTHROPIC_API_KEY=dummy_anthropic_key_for_dev
MODEL_SMALL=claude-3-5-haiku-20241022
MODEL_STRONG=claude-3-5-sonnet-20241022
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=dummy_openai_key_for_dev
VOYAGE_API_KEY=

# Cost & Quota Guardrails
DAILY_USER_USD_BUDGET=5.00
GLOBAL_DAILY_USD_CAP=500.00
AI_KILL_SWITCH=false

# Google OAuth
GOOGLE_CLIENT_ID=dummy_google_client_id.apps.googleusercontent.com

# Storage (AWS S3 / Cloudflare R2)
S3_BUCKET=jobscout-resumes
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=dummy_s3_key
S3_SECRET_ACCESS_KEY=dummy_s3_secret

# Payments
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_PRICE_ID_PRO=price_dummy_pro
STRIPE_PRICE_ID_PREMIUM=price_dummy_premium

RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=rzp_secret_dummy
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_dummy
RAZORPAY_PLAN_ID_PRO=plan_dummy_pro
RAZORPAY_PLAN_ID_PREMIUM=plan_dummy_premium

# Email & Notifications (Resend)
RESEND_API_KEY=re_dummy_key
FROM_EMAIL=notifications@jobscout.ai

# External Job Boards APIs (Public / Authorized)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
ENABLE_REMOTEOK_INGESTION=true
ENABLE_GREENHOUSE_INGESTION=true
ENABLE_LEVER_INGESTION=true
ENABLE_ASHBY_INGESTION=true
