{
  "name": "jobscout-api",
  "version": "1.0.0",
  "description": "Production-ready backend API for JobScout AI Job-Hunt Agent",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:stack": "node scripts/dev-stack.mjs",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "smoke": "node scripts/smoke.js",
    "test": "node --import ./tests/test-env.js --test tests/*.test.js",
    "ensure-indexes": "node scripts/ensure-indexes.js",
    "ensure-indexes:report": "node scripts/ensure-indexes.js --dry-run",
    "jobs:migrate": "node scripts/migrate-job-catalog.js",
    "jobs:migrate:report": "node scripts/migrate-job-catalog.js --report",
    "jobs:migrate:apply": "node scripts/migrate-job-catalog.js --apply",
    "jobs:migrate:rollback": "node scripts/migrate-job-catalog.js --rollback",
    "jobs:storage:report": "node scripts/migrate-job-storage-split.js --report",
    "jobs:storage:apply": "node scripts/migrate-job-storage-split.js --apply",
    "jobs:bench:scale": "node scripts/benchmark-jobs-scale.js",
    "jobs:ingest:source": "node scripts/ingest-job-source.js",
    "jobs:seed:dev": "node scripts/seed-jobs-dev.js",
    "jobs:schedule:report": "node scripts/jobs-schedule-report.js",
    "eval:match-versions": "node scripts/evaluate-match-versions.js",
    "eval:match-rank-gate": "node scripts/evaluate-job-ranking-gate.js",
    "jobs:features:report": "node scripts/backfill-job-features.js",
    "jobs:features:apply": "node scripts/backfill-job-features.js --apply",
    "jobs:occupation:report": "node scripts/backfill-job-occupations.js",
    "jobs:occupation:apply": "node scripts/backfill-job-occupations.js --apply",
    "jobs:eligibility:report": "node scripts/backfill-job-eligibility.js",
    "jobs:eligibility:apply": "node scripts/backfill-job-eligibility.js --apply",
    "jobs:eligibility:distribution": "node scripts/report-eligibility-distribution.js",
    "jobs:match:preview": "node scripts/jobs-match-preview.js",
    "jobs:ats:validate": "node scripts/ats-company-tools.js validate",
    "jobs:ats:import": "node scripts/ats-company-tools.js import",
    "jobs:ats:harvest": "node scripts/harvest-ats-candidates.js",
    "jobs:occupation:labels": "node scripts/export-occupation-label-sheet.js",
    "jobs:occupation:score-labels": "node scripts/score-occupation-label-sheet.js",
    "jobs:companies:report": "node scripts/sync-company-master.js",
    "jobs:companies:apply": "node scripts/sync-company-master.js --apply",
    "jobs:companies:rollback": "node scripts/sync-company-master.js --rollback",
    "jobs:jobstream:measure": "node scripts/measure-jobstream.js",
    "eval:jobs-phase3": "node scripts/evaluate-match-phase3.js",
    "jobs:local-profile-report": "node scripts/report-local-phase3.js",
    "jobs:local-measure": "node scripts/measure-local-phase3.js",
    "jobs:bson:measure": "node scripts/measure-job-bson.js",
    "jobs:storage:verify": "node scripts/verify-job-storage-split.js",
    "jobs:storage:compact:report": "node scripts/compact-job-hot-documents.js",
    "jobs:storage:compact:apply": "node scripts/compact-job-hot-documents.js --apply",
    "jobs:storage:compact:rollback": "node scripts/compact-job-hot-documents.js --rollback",
    "jobs:discovery:explain": "node scripts/explain-job-discovery.js",
    "jobs:occupation:sample": "node scripts/sample-occupation-review.js",
    "jobs:occupation:accuracy": "node scripts/report-occupation-accuracy.js",
    "resumes:cleanup-report": "node scripts/cleanup-orphan-resumes.js",
    "resumes:roles:report": "node scripts/resume-role-report.js",
    "career-profile:migration:report": "node scripts/career-profile-migration-report.js",
    "interview:usage": "node scripts/interview-usage-report.js",
    "eval:interviews": "node scripts/eval-interviews.js",
    "openapi": "node scripts/openapi.js",
    "docs:check": "node scripts/check-ai-docs.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "node scripts/prepare-hooks.mjs",
    "verify": "npm run lint && npm test && npm run docs:check",
    "verify:push": "node scripts/verify.mjs push",
    "verify:release": "node scripts/verify.mjs release",
    "scan:secrets": "node scripts/scan-secrets.mjs working",
    "check:branch-name": "node scripts/check-branch-name.mjs",
    "stack:up": "node scripts/stack.mjs up",
    "stack:down": "node scripts/stack.mjs down",
    "smoke:compose": "node scripts/stack.mjs smoke"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@langchain/anthropic": "^0.3.15",
    "@langchain/core": "^0.3.40",
    "@langchain/google-genai": "^0.2.18",
    "@langchain/langgraph": "^0.2.45",
    "@langchain/langgraph-checkpoint-mongodb": "^0.0.3",
    "@langchain/openai": "^0.4.4",
    "@sentry/node": "^8.54.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.41.4",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "langfuse": "^3.35.2",
    "mammoth": "^1.9.0",
    "mongoose": "^8.10.1",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.3",
    "opossum": "^8.4.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.16.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.5",
    "resend": "^4.1.2",
    "voyageai": "^0.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.1"
  }
}
