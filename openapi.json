{
  "openapi": "3.1.0",
  "info": {
    "title": "JobScout Backend API",
    "version": "1.0.0",
    "description": "Production-ready backend API for JobScout, an AI-powered job-hunt agent for Discover -> Evaluate -> Prepare -> Manage workflows."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development server"
    },
    {
      "url": "https://api.jobscout.ai",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness probe",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Process is live"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness probe",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "All dependencies reachable"
          },
          "503": {
            "description": "Dependencies degraded"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register new candidate account",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "201": {
            "description": "Candidate created with tokens"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate candidate",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Session created"
          }
        }
      }
    },
    "/api/v1/auth/google": {
      "post": {
        "summary": "Google OAuth token exchange",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Session created"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Rotate refresh token with reuse detection",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "New token pair issued"
          },
          "401": {
            "description": "Token reuse detected or expired"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Get current candidate profile and plan",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User session details"
          }
        }
      }
    },
    "/api/v1/profile/upload-resume": {
      "post": {
        "summary": "Upload PDF/DOCX resume for structured fact parsing",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Resume encrypted and parsed with factIds"
          }
        }
      }
    },
    "/api/v1/profile/preferences": {
      "put": {
        "summary": "Update target role, salary, and location preferences",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Preferences updated and version bumped"
          }
        }
      }
    },
    "/api/v1/profile/facts": {
      "get": {
        "summary": "List all immutable candidate facts with unique factIds",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of facts"
          }
        }
      }
    },
    "/api/v1/ai/models": {
      "get": {
        "summary": "List configured free-tier chat models",
        "tags": [
          "AI Router"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Configured models allowed for user chat"
          }
        }
      }
    },
    "/api/v1/ai/route": {
      "post": {
        "summary": "Classify and route candidate prompt across 3 tiers",
        "tags": [
          "AI Router"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Routing decision & execution output"
          }
        }
      }
    },
    "/api/v1/ai/chat": {
      "post": {
        "summary": "SSE streaming AI conversational endpoint",
        "description": "Required modelId is checked against the server-side selectable free-tier model allowlist.",
        "tags": [
          "AI Router"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Text event stream with routing & token events"
          }
        }
      }
    },
    "/api/v1/memories": {
      "get": {
        "summary": "List candidate long-term memories",
        "tags": [
          "Memories"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate memories"
          }
        }
      }
    },
    "/api/v1/memories/toggle-pause": {
      "post": {
        "summary": "Pause or unpause agent memory writes",
        "tags": [
          "Memories"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Memory status toggled"
          }
        }
      }
    },
    "/api/v1/memories/forget-all": {
      "post": {
        "summary": "Purge candidate vector memory collection",
        "tags": [
          "Memories"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Memories cleared"
          }
        }
      }
    },
    "/api/v1/jobs/matches": {
      "get": {
        "summary": "Get precomputed top job matches with L1 cache",
        "tags": [
          "Jobs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of scored job matches"
          }
        }
      }
    },
    "/api/v1/jobs/catalog": {
      "get": {
        "summary": "Search the paginated catalog of indexed jobs",
        "tags": [
          "Jobs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remoteType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "remote",
                "hybrid",
                "onsite"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered indexed jobs and pagination metadata"
          }
        }
      }
    },
    "/api/v1/jobs/discover": {
      "post": {
        "summary": "Trigger on-demand discovery pipeline",
        "tags": [
          "Jobs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Discovery results"
          }
        }
      }
    },
    "/api/v1/jobs/{id}/feedback": {
      "post": {
        "summary": "Record match feedback (thumbs up / down) and update preferences",
        "tags": [
          "Jobs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Feedback recorded"
          }
        }
      }
    },
